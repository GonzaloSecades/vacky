# Local SpacetimeDB is the only persisted backend on this branch.
SPACETIMEDB_URI="http://localhost:3000"
SPACETIMEDB_DB_NAME="vacky-spacetimedb-local-dev"
NEXT_PUBLIC_SPACETIMEDB_URI="http://localhost:3000"
NEXT_PUBLIC_SPACETIMEDB_DB_NAME="vacky-spacetimedb-local-dev"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# UploadThing placeholders.
UPLOADTHING_TOKEN="replace-with-uploadthing-token"

# Google Maps / Places placeholders.
GOOGLE_MAPS_API_KEY="replace-with-server-google-maps-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="replace-with-browser-google-maps-key"
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"
