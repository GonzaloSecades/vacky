# Local Docker Postgres is the default development database.
DATABASE_URL="postgresql://vacky:vacky@localhost:5432/vacky?schema=public"
VACKY_DATABASE_DRIVER="postgres"
POSTGRES_DB="vacky"
POSTGRES_USER="vacky"
POSTGRES_PASSWORD="vacky"
POSTGRES_PORT="5432"

# For explicit cloud-like local testing against Neon, replace DATABASE_URL
# with a Neon URL and set VACKY_DATABASE_DRIVER="neon".

# NextAuth / GitHub OAuth placeholders.
AUTH_SECRET="replace-with-a-local-secret"
AUTH_GITHUB_ID="replace-with-github-client-id"
AUTH_GITHUB_SECRET="replace-with-github-client-secret"

# UploadThing placeholders.
UPLOADTHING_TOKEN="replace-with-uploadthing-token"

# Google Maps / Places placeholders.
GOOGLE_MAPS_API_KEY="replace-with-server-google-maps-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="replace-with-browser-google-maps-key"
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"
