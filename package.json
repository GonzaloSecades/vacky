{
  "name": "vacky",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:local": "node scripts/dev-local.mjs",
    "stdb:start": "spacetime start --listen-addr 127.0.0.1:3000 --non-interactive",
    "stdb:publish:local": "spacetime publish vacky-spacetimedb-local-dev --server http://127.0.0.1:3000 --module-path spacetimedb",
    "stdb:publish:reset": "spacetime publish vacky-spacetimedb-local-dev --server http://127.0.0.1:3000 --delete-data=always -y --module-path spacetimedb",
    "stdb:generate": "spacetime generate --lang typescript --out-dir lib/spacetimedb/module_bindings --module-path spacetimedb",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-tabs": "^1.1.4",
    "@react-google-maps/api": "^2.20.6",
    "@uploadthing/react": "^7.3.0",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "3.17.7",
    "lucide-react": "^0.487.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-globe.gl": "^2.33.2",
    "react-hot-toast": "^2.5.1",
    "spacetimedb": "^2.1.0",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.2.5",
    "uploadthing": "^7.5.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.177.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
